@echo off
echo Talking disk for 2005-2010 PCs: FreeDOS + SBEMU (Intel HD Audio and PCI cards) + DEC talk + Provox.
echo   SAY text        speak text          SAY /X   stop speaking
echo   PV7 ...         Provox settings (PV7 with no arguments lists them)
echo   DEL A:\VOICE.BAT then reboot     run the spoken sound-hardware menu again
echo   SBEMU /O0  or  SBEMU /O1        switch between headphone and speaker output (also /VOL0-100)
echo   EXIT            unload speech and return to the plain prompt
echo Switch to your own DOS disk once you are up: the speech stays resident.
