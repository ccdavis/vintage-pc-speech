; provox 7.x -- 0preface.a
;
; build provox.exe with these tools:
; A86 macro assembler, V3.22 Copyright 1990 Eric Isaacson
; Turbo Link Version 7.00 Copyright (c) 1987, 1994 Borland International
;
; Required source files are:
; 0PREFACE.A 1I5CODE.A 2I8CODE.A 3I9CODE.A 4I9JUMPS.A
; 5OTHERS.A 6I16CODE.A 7I22CODE.A 8I47CODE.A 9PROVOX7.A
;
; At a DOS prompt type these commands:
; a86 +os *.a
; tlink -k provox7
;
revision equ '5' shl 8 or '0' ; change first value first
; defaults
f3def equ 0 ; say numbers
f4def equ 0 ; say cap
f5def equ 2 ; punctuation
f6def equ 0 ; smart screen
f7def equ 1 ; keyboard echo
f8def equ 1 ; screen echo
f9def equ 2 ; speed
f10def equ 3 ; volume
f19def equ 80 ; warning bell column
f20def equ 1 ; watchdog threshold
; internal constants
sysnumber equ 241 ; for multiplex identification
dec_sysnumber equ 208
stacksize equ 256 ; bytes
maxlines equ 60
maxvoxnum equ 10
shelfsize equ 80
clipsize equ 512
bufsize equ maxlines*82 ; 80 bytes + cr + lf per line
bit0 equ 1 shl 0
bit1 equ 1 shl 1
bit2 equ 1 shl 2
bit3 equ 1 shl 3
bit4 equ 1 shl 4
bit5 equ 1 shl 5
bit6 equ 1 shl 6
bit7 equ 1 shl 7
bit8 equ 1 shl 8
bit9 equ 1 shl 9
bit10 equ 1 shl 10
bit11 equ 1 shl 11
bit12 equ 1 shl 12
bit13 equ 1 shl 13
bit14 equ 1 shl 14
bit15 equ 1 shl 15
; equates for states0
enhanced equ bit0
tsr_type equ bit1
buzzer equ bit2
watchdog equ bit3
routing equ bit4
output_busy equ bit5
ansi1flag equ bit6
ansi2flag equ bit7
; equates for states1
holding equ bit0
joined equ bit1
closed equ bit2
i8busy equ bit3
i9busy equ bit4
dec_ready equ bit5
graphics equ bit6
continuous equ bit7
passthru equ bit8
ph1flag equ bit9
ph2flag equ bit10
digit2 equ bit11
suppress equ bit12
i16flip equ bit13 ; backspace toggle
portopen equ bit14 ; openport active
dataflow equ bit15 ; handshake active
; equates for states2
email1 equ bit0 ; active
email2 equ bit1 ; dumping
email3 equ bit2 ; ignoring
; equates for states3
pasting equ bit0 ; pasting the clipboard
endofline equ bit1 ; cursor moved left
; dos and ascii constants
stderr equ 2
bsp equ 8
tab equ 9
lf equ 10
cr equ 13
escp equ 27
silence equ 28
repeated equ 29
times equ 30
return equ 31
spc equ 32
ro equ 127
; data required for device driver structure
 dw -1, -1 ; link to other device drivers
 dw bit15 ; character device
 dw offset strategy
 dw offset activity
 db 8 dup (sysnumber)
configdata: ; start of configuration area
voxnumber dw maxvoxnum shl 1 ; illegal until initialized
voxport dw 0 ; lpt#, com#, tts#
boxdrive db 'c' ; for snapshot path
prefix db '/' ; might be slash, accent, or escape
f9flag db f9def
f10flag db f10def
autoload db 0
states0 db 0
bank0name db '>', 15 dup (0) ; dos prompt
bank0sub db 8 dup (0)
