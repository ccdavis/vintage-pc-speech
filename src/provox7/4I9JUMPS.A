 db 224, 75 ; left arrow
 dw rvw01
 db 240, 76 ; center key
 dw rvw08
 db 0, 77 ; right arrow
 dw rvw02
 db 224, 77 ; right arrow
 dw rvw02
 db 0, 86 ; shift f3
 dw i9pr24
 db 0, 87 ; shift f4
 dw i9pr25
 db 0, 115 ; ctrl left arrow
 dw rvw09
 db 224, 115 ; ctrl left arrow
 dw rvw09
 db 0, 116 ; ctrl right arrow
 dw rvw11
 db 224, 116 ; ctrl right arrow
 dw rvw11
 dw 0 ; end of table1
; commands in direct mode only
table2 db '/', 53 ; change prefix
 dw i9pr06
 db '`', 41 ; change prefix
 dw i9pr06
 db escp, 1 ; change prefix
 dw i9pr06
 db 'N', 49 ; name screen bank
 dw i9pr17
 db 'P', 25 ; paste from clipboard
 dw i9pr34
 db 'R', 19 ; report seconds
 dw i9pr35
 db 'Z', 44 ; reset clock count
 dw i9pr36
 db '=', 13 ; define a sub screen
 dw i9pr23
 db 0, 64 ; f6
 dw i9pr30
 db '?', 53 ; interrogate
 dw i9pr31
 db 0, 71 ; home -- read top line
 dw i9pr19
 db 224, 71 ; home -- read top line
 dw i9pr19
 db 0, 72 ; up arrow
 dw i9pr26
 db 224, 72 ; up arrow
 dw i9pr27
 db 0, 80 ; down arrow
 dw i9pr28
 db 224, 80 ; down arrow
 dw i9pr29
 db 0, 79 ; end -- read bottom line
 dw i9pr20
 db 224, 79 ; end -- read bottom line
 dw i9pr20
 db 9, 15 ; tab right -- read a box
 dw i9pr21
 db 'B', 48 ; background attributes
 dw i9pr22
 db 'E', 18 ; email filter
 dw i9pr33
 db 'F', 33 ; foreground attributes
 dw i9pr22
 db 'H', 35 ; highlights
 dw i9pr02
 db 'O', 24 ; openport
 dw i9pr32
 db 0, 81 ; page down -- read continuous
 dw i9pr07
 db 224, 81 ; page down -- read continuous
 dw i9pr07
 db 0, 82 ; ins -- report keystroke
 dw i9pr18
 db 224, 82 ; ins -- report keystroke
 dw i9pr18
 db cr, 28 ; enter review
 dw i9pr03
 db cr, 224 ; enter review
 dw i9pr03
 db 0, 84 ; shift f1
 dw i9pr16
 db 0, 85 ; shift f2
 dw i9pr08
 db 0, 88 ; shift f5
 dw i9pr14
 db 0, 89 ; shift f6
 dw i9pr15
 db 0, 92 ; shift f9
 dw i9pr12
 db 0, 93 ; shift f10
 dw i9pr13
 dw 0 ; end of table2
; commands in review mode only
table3 db lf, 28 ; route cursor and exit review
 dw i9pr04
 db cr, 224 ; join cursors
 dw i9dr09
 db 'H', 35 ; highlights
 dw i9pr02
 db 0, 72 ; up arrow
 dw rvw03
 db 224, 72 ; up arrow
 dw rvw03
 db 0, 80 ; down arrow
 dw rvw04
 db 224, 80 ; down arrow
 dw rvw04
 db 0, 117 ; ctrl-end
 dw i9pr10
 db 224, 117 ; ctrl-end
 dw i9pr10
 db 0, 119 ; ctrl-home
 dw i9pr10
 db 224, 119 ; ctrl-home
 dw i9pr10
 db 0, 118 ; ctrl-page down
 dw i9pr11
 db 224, 118 ; ctrl-page down
 dw i9pr11
 db 0, 132 ; ctrl-page up
 dw i9pr11
 db 224, 132 ; ctrl-page up
 dw i9pr11
 db cr, 28 ; exit review
 dw i9pr05
 db escp, 1 ; prefix capture
 dw i9pr01
 db '/', 53 ; prefix capture
 dw i9pr01
 db '`', 41 ; prefix capture
 dw i9pr01
 db 0, 71 ; home
 dw rvw13
 db 224, 71 ; home
 dw rvw13
 db 0, 73 ; page up
 dw rvw14
 db 224, 73 ; page up
 dw rvw14
 db 0, 79 ; end
