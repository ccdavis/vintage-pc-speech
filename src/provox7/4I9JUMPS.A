 db '+', 78 ; current line
 dw rvw06
 db 'T', 20 ; time of day
 dw i9ts32
 db 'L', 38 ; cursor line
 dw rvw06
 db '<', 51 ; left part
 dw get1screen
 db '>', 52 ; right part
 dw get1screen
 db 'C', 46 ; current char
 dw rvw08
 db '-', 74 ; current word
 dw rvw10
 db 'W', 17 ; current word
 dw rvw10
 db '*', 9 ; current character
