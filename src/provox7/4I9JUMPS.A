 db '*', 55 ; current character
 dw rvw12
 db 'S', 31 ; whole screen
 dw get1screen
 db '-', 12 ; upper part
 dw get1screen
 db '+', 13 ; lower part
 dw get1screen
 db 'G', 34 ; get into clipboard
 dw i9ts35
 db 'K', 37 ; kill the clipboard
 dw i9ts36
 db 0, 59 ; f1
 dw i9ts28
 db 0, 60 ; f2
 dw i9ts29
 db 0, 61 ; f3
 dw i9ts03
 db 0, 62 ; f4
 dw i9ts04
 db 0, 63 ; f5
